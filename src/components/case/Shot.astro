---
// A screen from a case study with its italic caption above it (Figma: Inter Italic 18/27, centred).
// Desktop: caption and image sit at their Figma coordinates. Mobile: caption stacks above the image.
// `lines` keeps Figma's exact line breaks on desktop; on small screens the text re-wraps naturally.
import type { ImageMetadata } from 'astro';
import Pic from '../Pic.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  x: number;
  y: number;
  w: number;
  /** caption lines, exactly as broken in Figma */
  lines?: string[];
  /** caption centre x and line-box top, in design px */
  cx?: number;
  top?: number;
  /** caption box width in design px (only affects centring) */
  capW?: number;
}

const { src, alt, x, y, w, lines = [], cx = x + w / 2, top = y - 60, capW = 340 } = Astro.props;
---

<figure class="shot-fig desk-contents">
  {
    lines.length > 0 && (
      <figcaption class="cap p" style={`--x:${cx - capW / 2};--y:${top};--w:${capW}`}>
        {lines.map((l, i) => (
          <>
            <span class="cap-line">{l}</span>
            {i < lines.length - 1 && ' '}
          </>
        ))}
      </figcaption>
    )
  }
  <Pic src={src} alt={alt} x={x} y={y} w={w} class="shot" mobile="44vw" />
</figure>
