---
import Case from '../../layouts/Case.astro';
import Pic from '../../components/Pic.astro';
import Objective from '../../components/case/Objective.astro';
import Scatter from '../../components/case/Scatter.astro';
import { caseBySlug } from '../../data/cases';
import challenges from '../../assets/onboarding/challenges.png';
import Shot from '../../components/case/Shot.astro';
import splash from '../../assets/onboarding/screen-splash.png';
import phone from '../../assets/onboarding/screen-phone.png';
import language from '../../assets/onboarding/screen-language.png';
import experience from '../../assets/onboarding/screen-experience.png';
import exit from '../../assets/onboarding/screen-exit.png';
import buysSells from '../../assets/onboarding/screen-buys-sells.png';
import backtested from '../../assets/onboarding/screen-backtested.png';
import nse from '../../assets/onboarding/screen-nse.png';
import welcome from '../../assets/onboarding/screen-welcome.png';
import blob4 from '../../assets/onboarding/blob-4.svg';
import blob3 from '../../assets/onboarding/blob-3.svg';
import blob2 from '../../assets/onboarding/blob-2.svg';
import blob1 from '../../assets/onboarding/blob-1.svg';

const study = caseBySlug('onboarding');

const sameBody =
  'I brought the core value proposition forward so users could understand what Returns Wealth offers before exploring the app.';
// Blob shapes from the Figma frame; the text in each row shares one baseline in Figma,
// so text offsets (tt = top, tl = left of a 400px centred column) are measured separately.
const decisions = [
  { t: '1. Lead with the product', x: 89.7, y: 3941.5, w: 566, h: 299.5, tt: 76.5, tl: 76.3, shape: blob1, rot: -2.69 },
  { t: '2. Understand user intent early', x: 688.7, y: 3940, w: 496, h: 321, tt: 78, tl: 50.8, shape: blob2, rot: 0 },
  { t: '3. Make education easier to consume', x: 109.7, y: 4289.9, w: 522.6, h: 335.6, tt: 91.1, tl: 57.8, shape: blob3, rot: 0 },
  { t: '4. Build confidence before activation', x: 688.7, y: 4297, w: 508, h: 319, tt: 84, tl: 50.8, shape: blob4, rot: 0 },
];

const steps = [
  ['1. Sign up', 'Register using an email address or phone number.'],
  ['2. Answer questions', 'Share information about market experience, investment budget, and user intent.'],
  ['3. Understand algos', 'Learn what algos do and how automated trading works.'],
  ['4. Discover algos', "Explore strategies that may align with the user's needs."],
  ['5. Build confidence', 'Access relevant information about strategies, credibility, and user control.'],
];

// Figma numbers every line of this list, including the lead-in and closing sentences.
// Journey boxes and arrows, measured from the Figma frame (design px)
const journey = [
  { x: 90, y: 4880, w: 308, h: 138 },
  { x: 880, y: 4880, w: 310, h: 162 },
  { x: 332, y: 5086, w: 310, h: 138 },
  { x: 884, y: 5096, w: 308, h: 138 },
  { x: 328, y: 5330, w: 310, h: 162 },
];
const arrows = [
  { x: 399, y: 4920, w: 479 },
  { x: 89, y: 5128, w: 241 },
  { x: 643, y: 5128, w: 238 },
  { x: 89, y: 5377, w: 231 },
];

const questions = [
  'Before designing the screens, I considered a few key questions:',
  'What should users understand before exploring algos?',
  'How can I explain automated trading without technical jargon?',
  'What questions would help me understand user intent?',
  'How can those answers make algo discovery more relevant?',
  'What information would help build trust?',
  'How can I move users from understanding the product to taking action?',
  'These questions shaped the direction of the onboarding experience.',
];
---

<Case
  study={study}
  height={8040}
  description="Onboarding case study for Returns Wealth: simplifying the first 60 seconds of a complex algo-investing product."
>
  <section class="brief p" style="--x:63;--y:1009;--w:1006">
    <h2 class="cs-h">Project Brief</h2>
    <p class="cs-body">
      Returns is an algo investing platform for retail users. As the product evolved, most new users were coming
      specifically to explore algos, but many did not fully understand how automated trading worked.
    </p>
    <p class="cs-body cs-strong">That made onboarding one of the most critical moments in the product.</p>
  </section>

  <section class="block p" style="--x:62;--y:1402;--w:1107">
    <h2 class="cs-h">Problem Statement</h2>
    <ol class="cs-list">
      <li>What an algo is</li>
      <li>How automated trading works</li>
      <li>Whether they can trust it</li>
      <li>What they should do next</li>
    </ol>
  </section>
  <p class="cs-body cs-strong p" style="--x:63;--y:1678;--w:1138">
    *The existing onboarding did not explain the core value early enough, which could create hesitation before users
    reached algo discovery and activation.
  </p>

  <Objective
    x={67}
    y={1874}
    intro="Design an onboarding experience that helps users:"
    rows={[
      [
        ['Understand the product within the first minute', 594],
        ['Build confidence in the platform', 448],
      ],
      [
        ['feel that the product is relevant to them', 529],
        ['Understand user intent after sign-up.', 513],
      ],
      [['move naturally toward their first algo activation', 646]],
    ]}
  />

  <Scatter
    heading="Challenges"
    headingY={2306}
    img={challenges}
    imgBox={[419, 2358, 436]}
    alt="Illustration: a cow pushing a huge boulder up a hill"
    labels={[
      ['Simplifying education', 176, 2391],
      ['Building trust', 769, 2481],
      ['Understanding user intent', 183, 2598],
      ['Reducing friction', 865, 2598],
    ]}
  />

  <section class="block p" style="--x:64;--y:2846;--w:1107">
    <h2 class="cs-h">Questions I started with</h2>
    <p class="cs-body cs-strong">Before designing the screens, I started with questions like:</p>
    <ol class="cs-list">
      {questions.map((q) => <li>{q}</li>)}
    </ol>
  </section>

  <section class="band insight p" style="--x:0;--y:3340;--w:1280">
    <div class="callout">
      <h2 class="cs-h">Insight</h2>
      <p class="cs-body">
        Users did not need to understand the technical logic behind an algo.<br />
        They needed to understand:<br />
        What it does for them.
      </p>
      <p class="cs-body">
        So instead of explaining trading systems, the experience focused on simple outcomes<br />
        Users need clarity about the product and relevance to their needs.
      </p>
    </div>
  </section>

  <div class="solution p cs-center" style="--x:0;--y:3784;--w:1280">
    <h2 class="cs-h">The solution</h2>
    <p class="cs-body sol-sub">I structured the onboarding experience around four key design decisions.</p>
  </div>

  <ul class="decisions desk-contents" role="list">
    {
      decisions.map((d) => (
        <li class="blob p" style={`--x:${d.x};--y:${d.y};--w:${d.w};--bh:${d.h};--tt:${d.tt};--tl:${d.tl};--shape:url(${d.shape.src});--rot:${d.rot}deg`}>
          <div class="blob-text">
            <h3>{d.t}</h3>
            <p>{sameBody}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="cs-body cs-center p" style="--x:230;--y:4745;--w:880">
    The journey connected sign-up, intent gathering, product education, and algo discovery into a more guided experience.
  </p>

  <ol class="journey desk-contents" role="list">
    {
      journey.map((j, i) => (
        <li class="step p" style={`--x:${j.x};--y:${j.y};--w:${j.w};--bh:${j.h}`}>
          <h3>{steps[i][0]}</h3>
          <p>{steps[i][1]}</p>
        </li>
      ))
    }
  </ol>
  {arrows.map((a) => <span class="arr p desk-only" style={`--x:${a.x};--y:${a.y};--w:${a.w}`} aria-hidden="true" />)}

  <section class="screens desk-contents" aria-label="Key onboarding screens">
    <h2 class="cs-body cs-strong p" style="--x:62;--y:5608;--w:600">Key Onboarding Screens</h2>

    <div class="shots desk-contents">
      <Shot src={splash} alt="Splash screen: “Wealth on autopilot, managed by experts”" x={40} y={5779} w={291} lines={['splash screen-Introduce', 'automated algo trading']} cx={183} top={5693} />
      <Shot src={phone} alt="Log in / sign up screen asking for a phone number, with keypad" x={487} y={5790} w={279} lines={['Enable access via email,', 'Google, or phone number.']} cx={620} top={5692} />
      <Shot src={language} alt="Choose your language: English or Hinglish" x={924} y={5790} w={284} lines={['Allow users to choose', 'their preferred language', 'for better accessibility.']} cx={1062.5} top={5693} />
      <Shot src={experience} alt="Describe your investing experience — three options" x={35} y={6585} w={292} lines={['Understand user goals through a', 'one-question-at-a-time', 'approach.']} cx={190} top={6498} />
      <Shot src={exit} alt="Education screen: “Don’t miss the right exit.”" x={472} y={6574} w={317} lines={['Used an animated storytelling', 'experience after the loading screen to', 'explain automated algo trading.']} cx={631} top={6498} />
      <Shot src={buysSells} alt="Education screen: “It Buys & Sells trades for you”" x={926} y={6572} w={285} lines={['Explained what automated', 'trading algorithms do.']} cx={1079} top={6498} />
      <Shot src={backtested} alt="Education screen: “25+ backtested algos — pick one that fits your goals & risk.”" x={40} y={7400} w={281} lines={['Guide users through', 'activation and algo selection.']} cx={177.5} top={7312} />
      <Shot src={nse} alt="Trust screen: “Powered by an NSE registered algo vendor.”" x={483} y={7388} w={278} lines={['Establish credibility by highlighting our', 'registration with the National Stock', 'Exchange']} cx={640} top={7306} />
      <Shot src={welcome} alt="Welcome aboard: “Let’s automate your investing journey.” with a testimonial" x={913} y={7388} w={291} lines={["Showcase the brand's vision and", 'user testimonials to build credibility', 'and confidence.']} cx={1065.5} top={7312} />
    </div>
  </section>
</Case>

<style>
  .insight {
    height: calc(333 * var(--u));
    padding: calc(28 * var(--u)) 0 0 calc(63 * var(--u));
  }

  .insight .callout {
    width: calc(1100 * var(--u));
    min-height: calc(273 * var(--u));
    padding-top: calc(3 * var(--u));
    padding-left: calc(27 * var(--u));
  }

  .insight .cs-body + .cs-body {
    margin-top: calc(32 * var(--u));
  }


  .decisions {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blob {
    height: calc(var(--bh) * var(--u));
    text-align: center;
    isolation: isolate;
  }

  /* organic shape exported from the Figma vectors */
  .blob::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--shape) center / 100% 100% no-repeat;
    transform: rotate(var(--rot));
  }

  .blob-text {
    position: absolute;
    top: calc(var(--tt) * var(--u));
    left: calc(var(--tl) * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(24 * var(--u));
    width: calc(400 * var(--u));
  }

  .blob h3 {
    margin: 0;
    font-size: calc(20 * var(--u));
    font-weight: 600;
    color: var(--ink-2);
  }

  .blob p {
    max-width: calc(398 * var(--u));
    font-size: calc(18 * var(--u));
    line-height: calc(24 / 18);
    letter-spacing: -0.005em;
  }

  .journey {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    min-height: calc(var(--bh) * var(--u));
    padding: calc(22 * var(--u)) calc(20 * var(--u));
    border-radius: calc(6 * var(--u));
    background: var(--acc-bg);
  }

  .step h3 {
    margin: 0 0 calc(20 * var(--u));
    font-size: calc(20 * var(--u));
    font-weight: 600;
    color: var(--ink-2);
  }

  .step p {
    font-size: calc(16 * var(--u));
    line-height: 1.5;
  }

  /* arrow: 8px shaft + 40×44 head, as drawn in Figma */
  .arr {
    height: calc(44 * var(--u));
  }

  .arr::before {
    content: '';
    position: absolute;
    left: 0;
    right: calc(38 * var(--u));
    top: calc(18 * var(--u));
    height: calc(8 * var(--u));
    background: var(--acc);
  }

  .arr::after {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    border-left: calc(40 * var(--u)) solid var(--acc);
    border-top: calc(22 * var(--u)) solid transparent;
    border-bottom: calc(22 * var(--u)) solid transparent;
  }

  @media (max-width: 1023.98px) {
    .insight {
      height: auto;
    }

    .insight .callout {
      width: auto;
      min-height: 0;
      padding-top: 0;
    }

    .insight .cs-body + .cs-body {
      margin-top: 14px;
    }


    .decisions {
      display: grid;
      gap: 14px;
    }

    .blob {
      position: relative;
      height: auto;
      padding: 36px 34px;
    }

    .blob-text {
      position: static;
      gap: 8px;
      width: auto;
    }

    .blob h3 {
      font-size: 18px;
    }

    .blob p {
      max-width: 340px;
      font-size: 15px;
    }

    .journey {
      display: flex;
      flex-direction: column;
      gap: 26px;
    }

    .step {
      position: relative;
      min-height: 0;
      padding: 16px 18px;
      border-left: 4px solid var(--acc);
    }

    .step h3 {
      margin-bottom: 6px;
      font-size: 17px;
    }

    .step p {
      font-size: 15px;
    }

    .step + .step::before {
      content: '↓';
      position: absolute;
      top: -25px;
      left: 14px;
      font-size: 18px;
      line-height: 1;
      color: var(--acc);
    }

    .screens {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
