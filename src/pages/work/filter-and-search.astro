---
import Case from '../../layouts/Case.astro';
import Pic from '../../components/Pic.astro';
import Objective from '../../components/case/Objective.astro';
import { caseBySlug } from '../../data/cases';
import screenAll from '../../assets/filter/screen-all.png';
import screenInvestment from '../../assets/filter/screen-investment.png';
import screenTrading from '../../assets/filter/screen-trading.png';
import filtersAll from '../../assets/filter/filters-all.png';
import filtersInvestment from '../../assets/filter/filters-investment.png';
import filtersTrading from '../../assets/filter/filters-trading.png';
import sortSheet from '../../assets/filter/sort-sheet.png';
import bracket from '../../assets/filter/bracket.png';
import Shot from '../../components/case/Shot.astro';

const study = caseBySlug('filter-and-search');

const questions = [
  'What information matters most when choosing an algo?',
  'Which filters help users narrow down their options?',
  'How can beginners discover relevant strategies without technical knowledge?',
  'How can experienced traders search more precisely?',
  'How can we reduce the steps between discovery and activation?',
];
---

<Case
  study={study}
  height={5960}
  description="Filter & search case study: redesigning algo discovery with psychology-driven filters and direct search — a 20% increase in activation within the first 5 minutes."
>
  <section class="brief p" style="--x:63;--y:1009;--w:1006">
    <h2 class="cs-h">Project Brief</h2>
    <p class="cs-body">
      As the number of algos increased, users had more options but also more difficulty deciding which strategy was
      right for them.
    </p>
    <p class="cs-body">
      I worked on improving the discovery experience to help users narrow their choices, compare relevant information,
      and move toward activation with greater confidence.
    </p>
  </section>

  <section class="block p" style="--x:62;--y:1352;--w:1107">
    <h2 class="cs-h">Problem Statement</h2>
    <p class="cs-body tall">
      The existing navigation was divided into three broad categories: All, Investment, and Trading. While this structure
      organized the available algos, users still had to navigate through multiple options to find a strategy that suited
      them.
    </p>
    <p class="cs-body tall">
      The experience primarily helped users browse what was available, rather than helping them identify what was
      relevant to them.
    </p>
  </section>
  <p class="cs-body cs-strong p" style="--x:63;--y:1676;--w:1138">
    *This created decision friction at a critical point in the activation journey.
  </p>

  <Objective
    x={67}
    y={1804}
    intro="Design a discovery experience that helps users:"
    rows={[
      [
        ['Find suitable algos based on their preferences.', 598],
        ['Reduce unnecessary browsing.', 444],
      ],
      [
        ['Compare important information easily.', 492],
        ['Make algo discovery simpler and more intuitive.', 593],
      ],
      [['Search directly when they already know what they want.', 724]],
    ]}
  />

  <section class="block p" style="--x:64;--y:2216;--w:1107">
    <h2 class="cs-h">Questions I started with</h2>
    <p class="cs-body cs-strong">Before designing the screens, I started with questions like:</p>
    <ol class="cs-list">
      {questions.map((q) => <li>{q}</li>)}
    </ol>
  </section>

  <div class="solution p cs-center" style="--x:0;--y:2659;--w:1280">
    <h2 class="cs-h">The solution</h2>
    <p class="cs-body sol-sub">I introduced two key ways for users to discover algos.</p>
  </div>

  <ul class="ways p" style="--x:106;--y:2817;--w:1067" role="list">
    <li class="way">
      <h3>01. Relevant, Psychology-Driven Filters</h3>
      <p>I added filters designed around the way users evaluate and choose trading strategies.</p>
      <p class="hl">
        Instead of requiring users to browse through every available algo, the relevant filters on top helped them narrow
        their options based on relevant preferences and decision-making criteria.
      </p>
    </li>
    <li class="way">
      <h3>02. Direct Search</h3>
      <p>
        Support users who prefer a faster, more direct route to discovery instead of making them go through the same
        browsing journey as everyone else.
      </p>
    </li>
  </ul>

  <section class="block newdisc p" style="--x:69;--y:3245;--w:1107">
    <h2 class="cs-h">The New Discovery Experience</h2>
    <div class="nd">
      <p class="cs-body cs-strong">Before</p>
      <p class="cs-body tall">All / Investment / Trading → Browse available algos → Find a relevant strategy</p>
    </div>
    <div class="nd">
      <p class="cs-body cs-strong">After</p>
      <div class="cs-body tall">
        <p>Choose your approach:</p>
        <ul class="approach">
          <li><em>Filter: Narrow down algos based on relevant preferences.</em></li>
          <li><em>Search: Find a specific algo directly.</em></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="screens desk-contents" aria-label="Discovery screens">
    <p class="cs-body cs-strong p" style="--x:68;--y:3673;--w:1100">
      These are the key screens for searching, filtering, and sorting.
    </p>
    <div class="shots desk-contents">
      <Shot src={screenAll} alt="Explore Algos screen on the All tab with filter chips and algo cards" x={74} y={3808} w={235} lines={['Algo listing page']} cx={192.5} top={3766} />
      <Pic src={bracket} alt="" x={307} y={3907} w={42} class="desk-only" />
      <p class="cap p span-all" style="--x:350;--y:4093;--w:263">
        <span class="cap-line">Divided into three categories:</span>{' '}
        <span class="cap-line">All Algos, Investment Algos,</span>{' '}
        <span class="cap-line">and Trading Algos.</span>{' '}
        <span class="cap-break" aria-hidden="true"></span>
        <span class="cap-line em">Filters adapt based on the sele</span>{' '}
        <span class="cap-line em">cted navigation category.</span>
      </p>
      <Shot src={filtersAll} alt="Filters sheet with assets, index, strategy, minimum investment, market cap and risk" x={653} y={3819} w={243} lines={['All Filter page']} cx={765} top={3766} />
      <Shot src={sortSheet} alt="Sort bottom sheet: Newly added, Recommended, BNR, Min. Inv., Drawdown" x={935} y={4084} w={271} lines={['Sorting remains consistent', 'across all categories.']} cx={1084} top={3766} />
      <Shot src={screenInvestment} alt="Explore Algos screen on the Investment tab" x={74} y={4526} w={240} lines={['Investment Algos is selected.']} cx={192.5} top={4472} />
      <Shot src={filtersInvestment} alt="Filters sheet for investment algos" x={565} y={4544} w={243} lines={['Displays filters relevant to', 'investment algos.']} cx={691.5} top={4471} />
      <Shot src={screenTrading} alt="Explore Algos screen on the Trading tab with active filters" x={73} y={5206} w={243} lines={['Trading Algos is selected.']} cx={193} top={5169} />
      <Shot src={filtersTrading} alt="Filters sheet for trading algos with Apply Filters (6)" x={582} y={5252} w={242} lines={['Displays filters relevant to', 'Trading algos.']} cx={691.5} top={5168} />
    </div>
  </section>
</Case>

<style>
  .tall {
    line-height: calc(38 / 24);
  }

  .block .tall + .tall {
    margin-top: 0;
  }


  .ways {
    display: flex;
    gap: calc(65 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .way {
    flex: 1;
    height: calc(319 * var(--u));
    padding: calc(34 * var(--u)) calc(22 * var(--u)) calc(30 * var(--u)) calc(30 * var(--u));
    border-radius: calc(16 * var(--u));
    background: var(--acc-bg);
    font-size: calc(18 * var(--u));
    line-height: calc(24 / 18);
  }

  .way h3 {
    margin: 0 0 calc(19 * var(--u));
    font-size: calc(20 * var(--u));
    font-weight: 600;
    color: var(--ink-2);
  }

  .way .hl {
    margin-top: calc(12 * var(--u));
    padding: calc(4 * var(--u)) calc(2 * var(--u));
    background: color-mix(in srgb, var(--acc) 45%, white);
    font-style: italic;
  }

  /* Figma: label, 4px, text — and 34px between the Before and After groups */
  .newdisc .nd .cs-body + .cs-body {
    margin-top: calc(4 * var(--u));
  }

  .newdisc .nd + .nd {
    margin-top: calc(34 * var(--u));
  }

  .approach {
    margin: 0;
    padding-left: 1.2em;
    list-style: disc;
  }

  @media (max-width: 1023.98px) {

    .ways {
      flex-direction: column;
      gap: 14px;
    }

    .way {
      height: auto;
      padding: 22px 20px;
      border-radius: 14px;
      font-size: 16px;
      line-height: 1.5;
    }

    .way h3 {
      margin-bottom: 8px;
      font-size: 18px;
    }

    .way .hl {
      margin-top: 12px;
      padding: 8px 10px;
    }

    .block .tall + .tall {
      margin-top: 10px;
    }

    .newdisc .nd + .nd {
      margin-top: 18px;
    }

    .screens {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
